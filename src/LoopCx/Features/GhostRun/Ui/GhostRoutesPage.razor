@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<section aria-labelledby="ghost-heading">
    <button type="button" disabled="@saving" @onclick="GoBack">← @(selected is null ? "Run details" : "Your routes")</button>
    <p>Ghost Run · @(capture is not null && selected is null ? "Route capture" : "Route race")</p>
    <h2 id="ghost-heading" tabindex="-1">@(selected?.Route.Name ?? (catalogue ? "Your routes" : "Save route to Ghost Run"))</h2>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (loading) { <p role="status">Loading stored route…</p> }
    @if (saving) { <p role="status">Saving route…</p> }
    @if (selected is { } stored)
    {
        <h3>Race records</h3>
        <dl>
            <div><dt>Route</dt><dd>@Distance(stored.Route.LengthMetres) km · One direction</dd></div>
            <div><dt>Year best · @year</dt><dd>@Record(records?.YearBest)</dd></div>
            <div><dt>Personal best</dt><dd>@Record(records?.PersonalBest)</dd></div>
        </dl>
        <svg class="ghost-map" viewBox="0 0 320 240" role="img" aria-label="Recorded route geometry, from start to finish in recorded direction">
            <polyline points="@Coordinates(stored.Route)" />
        </svg>
        <p>Recorded geometry · background map unavailable.</p>
        @if (sourceReason is not null) { <p>@sourceReason</p> }
        <fieldset disabled="@(acquiring is not null)">
            <legend>Ghost reference</legend>
            <label><input type="radio" name="ghost-mode" checked="@(mode == GhostMode.YearBest)" @onchange="() => mode = GhostMode.YearBest" /> Year best · @year</label>
            <label><input type="radio" name="ghost-mode" checked="@(mode == GhostMode.PersonalBest)" @onchange="() => mode = GhostMode.PersonalBest" /> Personal best</label>
        </fieldset>
        <p>@(records?.ReferenceFor(mode) is null ? "Set first time without a ghost for this selection." : "Your selected record is frozen when the race starts.")</p>
        <p>Race time keeps running during stops and pauses.</p>
        @if (acquiring is not null) { <p role="status">Checking your actual GPS position at the start… Use Back to cancel.</p> }
        <button type="button" class="primary" disabled="@(acquiring is not null)" @onclick="StartRace">Start Ghost Run</button>
    }
    else if (catalogue)
    {
        @if (!loading && routes.Count == 0) { <p>Save a route after a continuous run.</p> }
        @foreach (var route in routes)
        {
            <button class="route-row" type="button" @onclick="() => OpenRoute(route.Route.Key)"><span>@route.Route.Name<small>@Distance(route.Route.LengthMetres) km · Recorded direction</small></span><span aria-hidden="true">›</span></button>
        }
    }
    else if (capture is { } prepared)
    {
        <EditForm Model="form" OnValidSubmit="SaveRoute">
            <DataAnnotationsValidator />
            <label for="ghost-route-name">Route name</label>
            <InputText id="ghost-route-name" @bind-Value="form.Name" disabled="@(saving || frozenSave is not null)" />
            <ValidationMessage For="() => form.Name" />
            <dl><div><dt>Route</dt><dd>Completed continuous main set only</dd></div><div><dt>Start / finish</dt><dd>Fixed · Recorded direction</dd></div></dl>
            <aside><strong>First benchmark</strong><p>@(prepared.Attempt.Quality == AttemptQuality.Verified ? "This policy-verified source becomes your first result. Stops and pauses count towards race time." : "Stops and pauses count towards race time. This source is not a verified benchmark: " + prepared.QualityReason)</p></aside>
            <svg class="ghost-map" viewBox="0 0 320 240" role="img" aria-label="Recorded main-route geometry; not a navigation map"><polyline points="@Coordinates(prepared.Geometry.Route)" /></svg>
            <button type="submit" class="primary" disabled="@(saving || !canRetry)" aria-busy="@saving">@(frozenSave is null ? "Save route" : "Retry saving")</button>
            <button type="button" disabled="@saving" @onclick="GoBack">Cancel</button>
        </EditForm>
    }
    else if (!loading)
    {
        <h3>Route cannot be saved</h3>
        <p>The source recording has not been changed.</p>
    }
</section>
