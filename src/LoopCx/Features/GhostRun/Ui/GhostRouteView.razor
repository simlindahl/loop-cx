@implements IAsyncDisposable
<figure class="route-view">
    <svg @ref="mapSlot" viewBox="@ViewBox" role="img" aria-label="Recorded route with fixed start, finish and direction. Runner and ghost markers use supported route positions only." focusable="false">
        <polyline class="route-line" points="@drawing.Line" />
        <circle class="route-start" cx="@drawing.Start.XText" cy="@drawing.Start.YText" r="8" />
        <path class="route-finish" d="M0 0V-17H13V-7H0" transform="@($"translate({drawing.Finish.Position})")" />
        <path class="route-direction" d="M0 -6L-5 5H5Z" transform="@Transform(direction, drawing.HeadingAt(Route.LengthMetres * .3))" />
        @if (ghostPoint is { } opponent) { <circle class="ghost-marker" cx="@opponent.XText" cy="@opponent.YText" r="10" /> }
        @if (runnerPoint is { } runner) { <path class="runner-marker" d="M0 -9L-7 7H7Z" transform="@Transform(runner, drawing.HeadingAt(markers.Runner!.Value))" /> }
    </svg>
    <figcaption>
        <p>@BackgroundStatus</p>
        <p class="route-legend"><span>○ Start</span><span>⚑ Finish</span><span>▲ Recorded direction</span>@if (Live) { <span class="runner-key">▲ You</span><span>● Ghost</span> }</p>
        @if (Live && markers.Runner is null) { <p>Your route position is unavailable. The race clock continues.</p> }
        @if (Live && GhostOutside) { <p>Ghost outside the current view.</p> }
    </figcaption>
    @if (Live && markers.Runner is not null) { <button type="button" @onclick="ToggleOverview">@(overview ? "Recenter on you" : "Route overview")</button> }
</figure>
