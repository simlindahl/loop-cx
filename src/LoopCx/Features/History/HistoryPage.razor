@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<section @ref="historyContent" class="history-content" aria-labelledby="@(ghostOpen ? "ghost-heading" : "history-heading")">
    @if (ghostOpen && detail is { } ghostSource)
    {
        <LoopCx.Features.GhostRun.Ui.GhostRoutesPage @ref="ghostPage" SourceRunId="ghostSource.Summary.Id" OnBack="CloseGhostRoutes" OnStarted="OnTraining" />
    }
    else
    {
    <button type="button" @onclick="GoBack">← @(sharingRun is not null ? "Back" : detailDestination is not null ? "Run details" : detail is null && partial is null && ghostResult is null ? "Training" : "History")</button>
    <h2 id="history-heading" tabindex="-1">@(sharingRun is not null ? "Your run, as data." : detailDestination is not null ? DetailTitle : partial is not null ? "Interrupted run" : ghostResult is not null ? "Ghost Run" : detail is null ? "History" : detail.Summary.Name)</h2>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (busy) { <p role="status">@(partial is null ? "Loading stored recording…" : "Saving recorded part…")</p> }
    @if (sharingRun is not null)
    {
        <p>A UTF-8 JSON file.</p>
        @if (sharingGhost)
        {
            <p>Includes frozen route geometry and rules, race and training time, pauses, data gaps and original GPS and heart-rate receipts. Missing measurements remain unknown.</p>
            <p>If selected, the full frozen comparison from a previous run is included: its identity, start and local zone, benchmark time and progress curve. That run’s separate raw GPS and heart rate are not fetched.</p>
        }
        else
        { <p>Includes the frozen plan and targets, phases, splits, heart rate, route coordinates, point assessment and continuity, pauses and data gaps. Older point quality may be unknown.</p> }
        <dl>
            <div><dt>Filename</dt><dd>@LoopCx.Features.ExportRun.RunJsonSharing.FileName</dd></div>
            <div><dt>Schema</dt><dd>Version @(sharingGhost ? "3 · Ghost" : "2") · units explicit</dd></div>
        </dl>
        <aside class="share-notice">
            <strong>Contains your route</strong>
            <p>Full export includes precise coordinates and UTC timestamps, along with recorded heart rate. Choose who receives this sensitive data.</p>
        </aside>
        @if (preparingShare) { <p role="status">Preparing JSON file…</p> }
        @if (shareMessage is not null) { <p role="status">@shareMessage</p> }
        <button id="share-open" type="button" class="primary" disabled="@preparingShare" aria-busy="@preparingShare" @onclick="OpenShareSheet">Open Android share sheet</button>
    }
    else if (ghostResult is { } ghostStored)
    {
        <LoopCx.Features.GhostRun.Ui.GhostResultView Stored="ghostStored" OnRoute="OnGhostRoute" />
        @if (ghostStored.Status == "interrupted" && ghostStored.SavedLocally is null && !recoveryUnavailable)
        {
            <button id="recovery-save" type="button" class="primary" disabled="@busy" aria-busy="@busy" @onclick="SaveGhostRecordedPart">@(recoveryFailed ? "Retry save" : "Save recorded part")</button>
        }
        @if (ghostStored.Status == "interrupted" && ghostStored.SavedLocally is not null)
        { <p role="status">Partial recording saved locally. The actual stop time is unknown.</p> }
        @if (GhostShareEligible)
        { <button id="history-share" type="button" @onclick="ShowShare">Share workout data</button> }
    }
    else if (partial is { } recorded)
    {
        var recordedDistance = Distance(recorded.Summary.Total);
        <p>@(recorded.SavedLocally is null ? "Your run was interrupted." : "Partial recording · saved locally")</p>
        <p>Only the last saved recording can be recovered. No time or distance is added after the last saved checkpoint. The actual stop time is unknown.</p>
        <dl>
            <div><dt>Last saved active time</dt><dd>@Time(recorded.Summary.TotalActive)</dd></div>
            <div><dt>Last saved distance</dt><dd>@(recordedDistance == "Unavailable" ? recordedDistance : recordedDistance + " km")</dd></div>
            <div><dt>Actual stop time</dt><dd>Unknown</dd></div>
        </dl>
        @if (recorded.SavedLocally is null && !recoveryUnavailable)
        {
            <button id="recovery-save" type="button" class="primary" disabled="@busy" aria-busy="@busy" @onclick="SaveRecordedPart">@(recoveryFailed ? "Retry save" : "Save recorded part")</button>
        }
        else if (recorded.SavedLocally is not null)
        {
            <p role="status">Partial recording saved locally.</p>
            <p>Not exported to Health Connect. A supported recorded end time is required for export.</p>
        <button id="history-share" type="button" @onclick="ShowShare">Share workout data</button>
        }
    }
    else if (detail is { } stored && detailDestination is not null)
    {
        @if (stored.Summary.Synthetic) { <p>Synthetic test recording · not a physical workout.</p> }
        @if (detailDestination == "splits")
        {
            <h3>Main-set splits</h3>
            <p>Frozen recorded results. Final partial split included once; missing measurements are not zero.</p>
            @if (stored.Measurements.Splits is not { } splits) { <p>Split measurements unavailable.</p> }
            else if (splits.Count == 0) { <p>No recorded main-set splits.</p> }
            else
            {
                <table class="split-table">
                    <caption>Main-set splits · time min:sec · distance km · pace min/km · heart rate bpm</caption>
                    <thead><tr><th scope="col">Split</th><th scope="col">Time</th><th scope="col">km</th><th scope="col">Avg pace</th><th scope="col">Avg HR</th></tr></thead>
                    <tbody>@foreach (var split in splits)
                    {
                        <tr><th scope="row">@SplitLabel(split)</th><td>@Time(split.Active)</td><td>@if (split.HasMeasuredDistance) { @Metres(split.Metres) } else { <span role="img" aria-label="Unavailable">—</span> }</td><td>@if (split.Pace is > 0) { @PaceValue(split.Pace) } else { <span role="img" aria-label="Unavailable">—</span> }</td><td>@if (split.HeartRate is { } bpm) { @Number(bpm) } else { <span role="img" aria-label="Unavailable">—</span> }</td></tr>
                    }</tbody>
                </table>
                <p class="split-table">— Unavailable. Missing measurements are not zero.</p>
                <details class="split-table"><summary>Split measurement coverage</summary>
                    @foreach (var split in splits) { <p>Split @SplitLabel(split) · @SplitCoverage(split)</p> }
                </details>
                <div class="split-cards">
                    @foreach (var split in splits)
                    {
                        <section><h4>Split @SplitLabel(split)</h4><dl class="split-metrics">
                            <div><dt>Active · min:sec</dt><dd>@Time(split.Active)</dd></div>
                            <div><dt>Distance · km</dt><dd>@(split.HasMeasuredDistance ? Metres(split.Metres) : "Unavailable")</dd></div>
                            <div><dt>Avg pace · min/km</dt><dd>@PaceValue(split.Pace)</dd></div>
                            <div><dt>Avg heart rate · bpm</dt><dd>@Number(split.HeartRate)</dd></div>
                        </dl><p>@SplitCoverage(split)</p></section>
                    }
                </div>
            }
            <h3>Recorded phases</h3>
            <p>Active time excludes pauses. Elapsed requires recorded start and end times; planned durations are never substituted.</p>
            @if (stored.Measurements.Phases is not { Count: > 0 } phases) { <p>Recorded phases unavailable.</p> }
            else
            {
                <table class="phase-table"><caption>Recorded phases · min:sec</caption><thead><tr><th scope="col">Phase</th><th scope="col">Active</th><th scope="col">Elapsed</th></tr></thead>
                    <tbody>@foreach (var phase in phases) { <tr><th scope="row">@PhaseLabel(phase)</th><td>@Time(phase.Active)</td><td>@Time(phase.Elapsed)</td></tr> }</tbody>
                </table>
                <div class="phase-cards">
                    @foreach (var phase in phases)
                    {
                        <section><h4>@PhaseLabel(phase)</h4><dl class="split-metrics">
                            <div><dt>Active · min:sec</dt><dd>@Time(phase.Active)</dd></div>
                            <div><dt>Elapsed · min:sec</dt><dd>@Time(phase.Elapsed)</dd></div>
                        </dl></section>
                    }
                </div>
            }
            <p>Per-phase distance, pace and heart rate: Unavailable. Whole-run totals are not divided between phases.</p>
        }
        else
        {
            <p>Frozen boundaries from this run's start. Time is based on valid recorded heart rate, not the intended target. Times are displayed in whole seconds.</p>
            @foreach (var entry in new[] { ("Main set", stored.Measurements.Main), ("Whole run · includes warm-up and cool-down", stored.Measurements.Whole) })
            {
                var scope = entry.Item2;
                <section><h3>@entry.Item1</h3><p>@Time(scope.Active) active</p>
                    @if (scope.Zones.Count == 0) { <p>Frozen heart-rate boundaries unavailable or not configured for this run.</p> }
                    else
                    {
                        <table><caption>Frozen heart-rate boundaries · bpm · time min:sec</caption><thead><tr><th scope="col">Zone</th><th scope="col">bpm</th><th scope="col">Time</th></tr></thead><tbody>
                            @foreach (var zone in scope.Zones) { <tr><th scope="row">Zone @zone.Number</th><td>@zone.MinimumBpm–@zone.MaximumBpm</td><td>@Time(zone.Active)</td></tr> }
                        </tbody></table>
                    }
                    <dl><div><dt>Known heart rate outside these zones</dt><dd>@Time(scope.Outside)</dd></div>
                        <div><dt>Unknown heart rate</dt><dd>@Time(scope.Unknown)</dd></div>
                        <div><dt>Known heart-rate coverage</dt><dd>@Time(scope.Known) of @Time(scope.Active) active</dd></div></dl>
                </section>
            }
            <p>Outside-zone time is known heart rate; unknown time is not assigned to a zone. The stored aggregate does not distinguish below Zone 1 from above maximum.</p>
        }
    }
    else if (!busy && detail is { } run)
    {
        var totalDistance = Distance(run.Summary.Total);
        var mainDistance = Distance(run.Main);
        var averageHeartRate = Number(run.Main?.AverageHeartRate);
        <p>@Started(run.Summary)</p>
        <p class="big-result">@totalDistance<small>@(totalDistance == "Unavailable" ? "Total distance" : "km total · accepted measurement")</small></p>
        @if (run.Summary.Synthetic) { <p>Synthetic test recording · not a physical workout.</p> }
        <dl>
            <div><dt>Total active / elapsed</dt><dd>@Time(run.Summary.TotalActive) / @Time(run.TotalElapsed)</dd></div>
            <div><dt>Main active / elapsed</dt><dd>@Time(run.MainActive) / @Time(run.MainElapsed)</dd></div>
            <div><dt>Main distance / avg pace</dt><dd>@(mainDistance == "Unavailable" ? mainDistance : mainDistance + " km") / @Pace(run.Main?.AveragePaceSecondsPerKilometre)</dd></div>
            <div><dt>Main average heart rate</dt><dd>@(averageHeartRate == "Unavailable" ? averageHeartRate : averageHeartRate + " bpm")</dd></div>
            <div><dt>Health Connect</dt><dd>@run.Summary.ExportLabel</dd></div>
        </dl>
        <button id="history-splits" class="history-row detail-row" type="button" @onclick='() => ShowDetailDestination("splits")'><span>Splits &amp; phases<small>Frozen main-set splits and recorded phase times</small></span><span class="history-chevron" aria-hidden="true">›</span></button>
        <button id="history-zones" class="history-row detail-row" type="button" @onclick='() => ShowDetailDestination("zones")'><span>Time in zones<small>Main set and whole run · frozen start boundaries</small></span><span class="history-chevron" aria-hidden="true">›</span></button>
        <details>
            <summary>Workout plan</summary>
            <dl>
            <div><dt>Warm-up / cool-down</dt><dd>@Time(run.Warmup) / @Time(run.Cooldown)</dd></div>
            <div><dt>Workout source</dt><dd>@run.Summary.Source</dd></div>
            <div><dt>Planned main set</dt><dd>@Dose(run.Plan)</dd></div>
            <div><dt>Optional target</dt><dd>@StoredRunProjection.TargetSummary(run.Targets, run.Plan is { Count: 1 } && run.Plan[0].Kind == LoopCx.Features.ActiveRun.RunPhase.Work)</dd></div>
            </dl>
        </details>
        @if (run.Summary.ExportLabel is "Pending" or "Action required")
        {
            <p>Your run is saved locally. Export is not confirmed; review Health Connect write access in Settings if needed.</p>
            <button type="button" disabled="@busy" @onclick="RetryHealthConnect">Retry export</button>
            <button type="button" @onclick="() => OnHealthSettings.InvokeAsync(run.Summary.Id)">Review Health Connect access</button>
        }
        @if (run.Summary.ExportLabel == "Exported")
        { <p>Written to Health Connect. This does not confirm WHOOP import.</p> }
        <details>
            <summary>Recorded measurements and coverage</summary>
            <p>@Coverage(run.Main)</p>
            <p>@ZoneSummary(run.Zones)</p>
        </details>
        @if (run.IsContinuousGhostSource) { <button id="history-ghost" type="button" @onclick="OpenGhostRoutes">Save route to Ghost Run</button> }
        <button id="history-share" type="button" class="primary" @onclick="ShowShare">Share workout data</button>
    }
    else if (!busy)
    {
        <p>Your work, kept local.</p>
        @foreach (var entry in HistoryEntries)
        {
            if (entry is LoopCx.Features.GhostRun.GhostStoredRun ghostEntry)
            {
            <button id="@($"history-{ghostEntry.Id}")" class="history-row" type="button" @onclick="() => Open(ghostEntry.Id)">
                <span class="history-label">Ghost Run · @ghostEntry.Checkpoint.Route.Name<small>@ghostEntry.Status · stored race recording</small></span>
                <span class="history-value">@Time(ghostEntry.Checkpoint.Snapshot.Clock.RaceElapsed)</span><span class="history-chevron" aria-hidden="true">›</span>
            </button>
            }
            else if (entry is StoredRunSummary item)
            {
            var distance = Distance(item.Total);
            <button id="@($"history-{item.Id}")" class="history-row" type="button" @onclick="() => Open(item.Id)">
                <span class="history-label">@item.Name<small>@Started(item) · @Time(item.TotalActive) total active · @item.ExportLabel</small></span>
                <span class="history-value">@(distance == "Unavailable" ? distance : distance + " km")</span>
                <span class="history-chevron" aria-hidden="true">›</span>
            </button>
            }
        }
        @if (runs.Count == 0 && ghostRuns.Count == 0 && error is null && unreadable == 0)
        {
            <p>@(interrupted > 0 ? "No completed runs are available here. Interrupted recordings are stored separately." : "No completed runs yet.")</p>
        }
        else if (interrupted > 0) { <p>Interrupted recordings stored separately: @interrupted.</p> }
        @if (partials.Count > 0)
        {
            <h3>Interrupted recordings</h3>
            @foreach (var entry in partials)
            {
                <button id="@($"history-{entry.Summary.Id}")" class="history-row" type="button" @onclick="() => OpenInterrupted(entry)">
                    <span class="history-label">@entry.Summary.Name<small>@Started(entry.Summary) · @(entry.SavedLocally is null ? "Interrupted · Action needed" : "Partial recording · saved locally")</small></span>
                    <span class="history-value recovery-value">Last saved @Time(entry.Summary.TotalActive) active</span>
                    <span class="history-chevron" aria-hidden="true">›</span>
                </button>
            }
        }
        @if (unreadable > 0) { <p role="alert">Some stored recordings could not be read. No data was changed.</p> }
    }
    }
</section>
