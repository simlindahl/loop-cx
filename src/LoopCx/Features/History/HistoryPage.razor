@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JS
<section aria-labelledby="history-heading">
    <button type="button" @onclick="GoBack">← @(detail is null && partial is null ? "Training" : "History")</button>
    <h2 id="history-heading" tabindex="-1">@(partial is not null ? "Interrupted run" : detail is null ? "History" : detail.Summary.Name)</h2>
    @if (error is not null) { <p role="alert">@error</p> }
    @if (busy) { <p role="status">@(partial is null ? "Loading stored recording…" : "Saving recorded part…")</p> }
    @if (partial is { } recorded)
    {
        var recordedDistance = Distance(recorded.Summary.Total);
        <p>@(recorded.SavedLocally is null ? "Your run was interrupted." : "Partial recording · saved locally")</p>
        <p>Only the last saved recording can be recovered. No time or distance is added after the last saved checkpoint. The actual stop time is unknown.</p>
        <dl>
            <div><dt>Last saved active time</dt><dd>@Time(recorded.Summary.TotalActive)</dd></div>
            <div><dt>Last saved distance</dt><dd>@(recordedDistance == "Unavailable" ? recordedDistance : recordedDistance + " km")</dd></div>
            <div><dt>Actual stop time</dt><dd>Unknown</dd></div>
        </dl>
        @if (recorded.SavedLocally is null && !recoveryUnavailable)
        {
            <button id="recovery-save" type="button" class="primary" disabled="@busy" aria-busy="@busy" @onclick="SaveRecordedPart">@(recoveryFailed ? "Retry save" : "Save recorded part")</button>
        }
        else if (recorded.SavedLocally is not null)
        {
            <p role="status">Partial recording saved locally.</p>
            <p>Not exported to Health Connect. A supported recorded end time is required for export.</p>
        }
    }
    else if (!busy && detail is { } run)
    {
        var totalDistance = Distance(run.Summary.Total);
        var mainDistance = Distance(run.Main);
        var averageHeartRate = Number(run.Main?.AverageHeartRate);
        <p>@Started(run.Summary)</p>
        <p class="big-result">@totalDistance<small>@(totalDistance == "Unavailable" ? "Total distance" : "km total · accepted measurement")</small></p>
        @if (run.Summary.Synthetic) { <p>Synthetic test recording · not a physical workout.</p> }
        <dl>
            <div><dt>Total active / elapsed</dt><dd>@Time(run.Summary.TotalActive) / @Time(run.TotalElapsed)</dd></div>
            <div><dt>Main active / elapsed</dt><dd>@Time(run.MainActive) / @Time(run.MainElapsed)</dd></div>
            <div><dt>Main distance / avg pace</dt><dd>@(mainDistance == "Unavailable" ? mainDistance : mainDistance + " km") / @Pace(run.Main?.AveragePaceSecondsPerKilometre)</dd></div>
            <div><dt>Main average heart rate</dt><dd>@(averageHeartRate == "Unavailable" ? averageHeartRate : averageHeartRate + " bpm")</dd></div>
            <div><dt>Warm-up / cool-down</dt><dd>@Time(run.Warmup) / @Time(run.Cooldown)</dd></div>
            <div><dt>Workout source</dt><dd>@run.Summary.Source</dd></div>
            <div><dt>Target effort</dt><dd>@Effort(run.Plan)</dd></div>
            <div><dt>Planned main set</dt><dd>@Dose(run.Plan)</dd></div>
            <div><dt>Optional target</dt><dd>@StoredRunProjection.TargetSummary(run.Targets, run.Plan is { Count: 1 } && run.Plan[0].Kind == LoopCx.Features.ActiveRun.RunPhase.Work)</dd></div>
            <div><dt>Health Connect</dt><dd>@run.Summary.ExportLabel</dd></div>
        </dl>
        <p>@Coverage(run.Main)</p>
        <p>@ZoneSummary(run.Zones)</p>
    }
    else if (!busy)
    {
        <p>Your work, kept local.</p>
        @foreach (var item in runs)
        {
            var distance = Distance(item.Total);
            <button id="@($"history-{item.Id}")" class="history-row" type="button" @onclick="() => Open(item.Id)">
                <span class="history-label">@item.Name<small>@Started(item) · @Time(item.TotalActive) total active · @item.ExportLabel</small></span>
                <span class="history-value">@(distance == "Unavailable" ? distance : distance + " km")</span>
                <span class="history-chevron" aria-hidden="true">›</span>
            </button>
        }
        @if (runs.Count == 0 && error is null && unreadable == 0)
        {
            <p>@(interrupted > 0 ? "No completed runs are available here. Interrupted recordings are stored separately." : "No completed runs yet.")</p>
        }
        else if (interrupted > 0) { <p>Interrupted recordings stored separately: @interrupted.</p> }
        @if (partials.Count > 0)
        {
            <h3>Interrupted recordings</h3>
            @foreach (var entry in partials)
            {
                <button id="@($"history-{entry.Summary.Id}")" class="history-row" type="button" @onclick="() => OpenInterrupted(entry)">
                    <span class="history-label">@entry.Summary.Name<small>@Started(entry.Summary) · @(entry.SavedLocally is null ? "Interrupted · Action needed" : "Partial recording · saved locally")</small></span>
                    <span class="history-value">Last saved @Time(entry.Summary.TotalActive) active</span>
                    <span class="history-chevron" aria-hidden="true">›</span>
                </button>
            }
        }
        @if (unreadable > 0) { <p role="alert">Some stored recordings could not be read. No data was changed.</p> }
    }
</section>
